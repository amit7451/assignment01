# ==============================================================================
# Microservices Environment Configuration Template
# Copy this file to .env before running services locally
# ==============================================================================

# Global Environment
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# API Gateway Configuration
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
JWT_SECRET=super_secure_jwt_secret_key_change_in_production_32chars
USER_SERVICE_URL=http://localhost:8001
NOTIFICATION_SERVICE_URL=http://localhost:8002
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# NATS Message Broker Configuration
# ------------------------------------------------------------------------------
NATS_URL=nats://localhost:4222
NATS_TOKEN=secure_nats_token_123
NATS_STREAM_NAME=USER_EVENTS

# ------------------------------------------------------------------------------
# User Service Configuration
# ------------------------------------------------------------------------------
USER_SERVICE_PORT=8001
USER_DB_TYPE=postgres
USER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/user_db
# For zero-dependency local run without PostgreSQL, uncomment:
# USER_DB_TYPE=sqlite
# USER_DATABASE_URL=./data/user.sqlite
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# Notification Service Configuration
# ------------------------------------------------------------------------------
NOTIFICATION_SERVICE_PORT=8002
NOTIFICATION_DB_TYPE=postgres
NOTIFICATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/notification_db
# For zero-dependency local run without PostgreSQL, uncomment:
# NOTIFICATION_DB_TYPE=sqlite
# NOTIFICATION_DATABASE_URL=./data/notification.sqlite
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@microservices.system
NOTIFICATION_DURABLE_NAME=notification-service-worker
INTERNAL_API_KEY=internal_secret_gateway_key_9988
